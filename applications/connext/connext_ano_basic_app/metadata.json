{
  "application": {
    "name": "Connext Advanced Network Basic Demo",
    "authors": [
      {
        "name": "NVIDIA Holoscan Team",
        "affiliation": "NVIDIA"
      }
    ],
    "language": "C++",
    "version": "1.0.0",
    "changelog": {
      "1.0.0": "Initial release - GPU-to-GPU tensor transfer demo"
    },
    "dockerfile": "applications/connext/connext_ano_basic_app/Dockerfile",
    "holoscan_sdk": {
      "minimum_required_version": "2.0.0",
      "tested_versions": [
        "2.0.0",
        "2.1.0",
        "2.2.0"
      ]
    },
    "platforms": ["x86_64", "aarch64"],
    "tags": ["Advanced Network", "DPDK", "GPUDirect", "Tensor Transfer"],
    "ranking": 0,
    "requirements": {
      "dpdk": ">=21.11",
      "cuda": ">=11.6",
      "gpu_direct": "required"
    },
    "modes": {
      "tx_rx": {
        "description": "Combined TX+RX in single DPDK process",
        "run": {
          "command": "<holohub_app_bin>/demo_ano_tx_rx <holohub_app_bin>/demo_ano_tx_rx.yaml",
          "workdir": "holohub_bin"
        }
      },
      "tx_rx_loopback": {
        "description": "Combined TX+RX in loopback mode (single DPDK process)",
        "run": {
          "command": "<holohub_app_bin>/demo_ano_tx_rx <holohub_app_bin>/demo_ano_tx_rx_loopback.yaml",
          "workdir": "holohub_bin"
        }
      },
      "tx": {
        "description": "TX only (separate process)",
        "run": {
          "command": "<holohub_app_bin>/connext_ano_basic_app tx <holohub_app_bin>/demo_ano_tx.yaml",
          "workdir": "holohub_bin"
        }
      },
      "rx": {
        "description": "RX only (separate process)",
        "run": {
          "command": "<holohub_app_bin>/connext_ano_basic_app rx <holohub_app_bin>/demo_ano_rx.yaml",
          "workdir": "holohub_bin"
        }
      }
    },
    "default_mode": "tx_rx"
  }
}
