{
  "application": {
    "name": "Connext ANO Loopback",
    "authors": [
      {
        "name": "Holohub Contributors",
        "affiliation": "NVIDIA"
      }
    ],
    "language": "Python",
    "version": "0.1.0",
    "changelog": {
      "0.1.0": "Initial example using Connext ANO operators"
    },
    "platforms": ["x86_64", "aarch64"],
    "tags": ["Networking and Distributed Computing", "DDS", "Connext"],
    "requirements": {
      "operators": [
        {
          "name": "connext_ano",
          "version": "0.1.0"
        }
      ]
    },
    "holoscan_sdk": {
      "minimum_required_version": "0.6.0",
      "tested_versions": [
        "0.6.0"
      ]
    },
    "dockerfile": "applications/connext/Dockerfile",
    "run": {
      "command": "python3 <holohub_app_source>/src/run_demo.py",
      "workdir": "holohub_app_bin"
    }
  }
}
